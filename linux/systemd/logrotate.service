[Unit]
Description=Rotate user log files
Documentation=man:logrotate(8)
Documentation=man:logrotate.conf(5)
Documentation=man:systemd.service(5)
Documentation=file:%h/.config/systemd/user/logrotate.service

[Service]
Type=oneshot
ExecStart=/usr/bin/logrotate \
  --state=%h/.local/state/logrotate/logrotate.status \
  --log=syslog \
  %h/.config/logrotate/logrotate.conf

[Install]
WantedBy=default.target
